GROQ_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=1536
MAX_CONTEXT_ARTICLES=10
SIMILARITY_THRESHOLD=0.7
UPLOAD_DIR=uploads
MAX_FILE_SIZE=20971520
